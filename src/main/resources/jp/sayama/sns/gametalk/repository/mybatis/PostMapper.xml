<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
  PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
  "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="jp.sayama.sns.gametalk.repository.mybatis.PostMapper">

  <!-- 投稿をINSERTする -->
  <insert id="insert" parameterType="jp.sayama.sns.gametalk.model.Post">
    INSERT INTO posts (content, author, created_at, media_path, media_type)
    VALUES (#{content}, #{author}, #{createdAt}, #{mediaPath}, #{mediaType})
  </insert>

 <!-- 🔽 明示的なresultMapを追加 -->
  <resultMap id="PostMap" type="jp.sayama.sns.gametalk.model.Post">
    <result property="content" column="content"/>
    <result property="author" column="author"/>
    <result property="createdAt" column="created_at"/>
  </resultMap>

  <!-- resultType → resultMap に変更 -->
  <select id="findAll" resultMap="PostMap">
    SELECT content, author, created_at, media_path, media_type
    FROM posts
    ORDER BY created_at DESC
  </select>

</mapper>
